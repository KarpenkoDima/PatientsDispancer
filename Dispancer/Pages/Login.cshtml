@page
@model Dispancer.Pages.LoginModel
@{
    ViewData["Title"] = "Вход - Медицинская система";
    Layout = null; // Используем собственный layout для страницы логина
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    @* Подключаем Bootstrap 5 для базовых компонентов *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    @* Подключаем Bootstrap Icons для иконок *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">

    @* Подключаем наш внешний файл стилей для страницы входа *@
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        Страница Входа Razor Pages
    </div>
</body>
</html>
