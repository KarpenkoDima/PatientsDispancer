@page
@model Dispancer.Pages.DashboardModel
@{
    ViewData["Title"] = "Панель управления";
    Layout = "_Layout"; // Используем собственный layout для страницы логина
}

@section Styles{
    <link rel="stylesheet" href="~/css/modals.css" asp-append-version="true"/>
}

@if (User.Identity?.IsAuthenticated == true)
{
    @**@
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-item" style="background: linear-gradient(135deg, #667eea 0%, #769ba2 100%); color: white;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-number">@(Model.Customers?.Count() ?? 0)</div>
                <div class="text-muted">Всего пациентов</div>
            </div>
        </div>
    </div>


@if (User.IsInRole("Sensitive_high"))
{
    <div class="col-md">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient()135deg, #f093fb 0%, #f556c 100%); color:white;"></div>
            <i class="bi bi-shield-check"></i>
        </div>
        <div class="stat-number">@Model.Username</div>
        <div>Права администратора</div>
            <form asp-page="/Logout" method="post">
                <button type="submit" class="btn btn-link">Выйти</button>
            </form>
    </div>
}
@if (User.IsInRole("Sensitive_medium"))
{
    <div class="col-md">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient()135deg, #f093fb 0%, #f556c 100%); color:white;"></div>
            <i class="bi bi-shield-check"></i>
        </div>
        <div class="stat-number">@Model.Username</div>
        <div>Права оператора</div>
    </div>
}
@if (User.IsInRole("Sensitive_low"))
{
    <div class="col-md">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient()135deg, #f093fb 0%, #f556c 100%); color:white;"></div>
            <i class="bi bi-shield-check"></i>
        </div>
        <div class="stat-number">@Model.Username</div>
        <div>Права регистратора</div>

    </div>
}

<div class="col-md-4">
    <div class="stat-card">
        <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
            <i class="bi bi-calendar-check"></i>
        </div>
        <div class="stat-number">@DateTime.Now.ToString("dd.MM")</div>
        <div class="text-muted">Сегодня</div>
    </div>
</div>

@* Основная карточка со списком пациент *@
<div class="card content-card">
    <div class="content-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-people-fill me-2"></i>
            Список пациентов
        </h5>
        @if (User.IsInRole("Sensitive_medium") || User.IsInRole("Sensitive_high"))
        {
                <button type="button" class="btn btn-light btn-sm" onclick="createCustomer()">
                    <i class="bi bi-plus-circle me-1"></i>
                    Добавить пациента
                </button>
        }
    </div>
</div>

<div class="content-body">
    @if (Model.Customers != null && Model.Customers.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Фамилия</th>
                        <th>Имя</th>
                        <th>Отчество</th>
                        <th>Дата рождения</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td><strong>@customer.CustomerID</strong></td>
                            <td>@customer.LastName</td>
                            <td>@customer.FirstName</td>
                            <td>@(customer.MiddleName ?? "-")</td>
                            <td>
                                @if(customer.Birthday.HasValue)
                                {
                                    <span class="badge bg-secondary">
                                        @customer.Birthday.Value.ToLongDateString()
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                    <a asp-page="/CustomerDetails" asp-route-CustomerID="@customer.CustomerID"
                                   class="btn btn-sm btn-primary btn-custom">
                                    <i class="bi bi-eye me-1"></i>
                                    Детали
                                </a>
                                @if (User.IsInRole("Sensitive_medium") == true || User.IsInRole("Sensitive_high"))
                                {
                                    // HTML Кавычки: Верните вызов ID в нормальный вид, но обязательно в кавычках:
                                    // onclick="editCustomerInline('@customer.CustomerID')".
                                    // Кнопка сохранения: В HTML кнопка "Сохранить" имела type="button". 
                                    // Чтобы сработал onsubmit формы, изменил её на type="submit"
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-custom ms-1"
                                            onclick="editCustomerInline('@customer.CustomerID')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (User.IsInRole("Sensitive_high"))
                                {
                                        @* Добавляем method="post", чтобы вызвать OnPost... *@
                                    <form method="post" class="btn btn-sm btn-outline-secondary btn-custom ms-1" asp-page-handler="DeleteCustomer" asp-route-id="@customer.CustomerID">
                                            @* Тип кнопки строго submit *@
                                        <button type="submit" class="btn btn-sm btn-outline-secondary btn-danger ms-1"
                                        onclick="return confirm('Вы уверены, что хотите удалить пациента')">                                               
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
             </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color:#ccc;"></i>
            <p class="text-muted mt-3">Пациенты не найдены</p>
            @(User.IsInRole("Sensitive_medium") || User.IsInRole("Sensitive_high"))
            {
                <button type="submit" form="customerForm" class="btn btn-primary btn-custom mt-2" onclick="createCustomer()">
                    <i class="bi bi-plus-circle me-1"></i>
                    Добавить первого пациента
                </button>
            }
        </div>
    }
    </div>
}
else
{
    <div class="card content-card">
        <div class="content-body text-center py-5">
            <i class="bi bi-shield-lock" style="font-size: 4rem; color: #667eea;"></i>
            <h4 class="mt-3">Требуется авторизация</h4>
            <p class="text-muted">
                Вы не авторизованы. Пожалуйста, <a asp-page="/Login">войдите в систему</a>.
            </p>
        </div>
    </div>
}

@* МОДАЛЬНОЕ ОКНО ДЛЯ СОЗДАНИЯ.РЕДАКТИРОВАНИЯ ПАЦИЕНТА *@
<div class="modal fade" id="customerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header modal-header-gradient">
                <h5 class="modal-title">
                    <i class="bi bi-person-fill me-2"></i>
                    <span id="customerModalTitle">Новый пациент</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="customerForm" onsubmit="return saveCustomer(event)">
                <div class="modal-body">
                    <input type="hidden" id="customerId" name="customerId" value="0" />
                    <div class="modal-section">
                        <h6 class="modal-section-title">Личные данные</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="lastName" class="form-label">Фамилия<span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="lastName" name="lastName" required />
                                <span class="text-danger" id="lastName-error"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="firstName" class="form-label">Имя<span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="firstName" name="firstName" required />
                                <span class="text-danger" id="firstName-error"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="middleName" class="form-label">Отчество</label>
                                <input type="text" class="form-control" id="middleName" name="middleName" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-section">
                        <h6 class="modal-section-title">Дополнительная информация</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="birthday" class="form-label">Дата рождения</label>
                                <input type="date" class="form-control" id="birthday" name="birthday" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="medCard" class="form-label">№ Мед карта</label>
                                <input type="number" class="form-control" id="medCard" name="medCard" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="codeCustomer" class="form-label">Код пациента</label>
                                <input type="number" class="form-control" id="codeCustomer" name="codeCustomer" />
                            </div>
                        </div>
                    </div>
                    <div id="customerFormError" class="alert alert-danger" style="display:none;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-mpdal-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>
                        Отмена
                    </button>
                    <button type="submit" form="customerForm" class="btn btn-primary btn-modal-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
